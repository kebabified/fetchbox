{
  "manifest_version": 3,
  "name": "Fetchbox",
  "description": "Download videos and audio from posts on any site yt-dlp supports, straight into Fetchbox.",
  "version": "2.0.4",
  "minimum_chrome_version": "121",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "Fetchbox",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "fetchbox@fetchbox",
      "strict_min_version": "128.0",
      "update_url": "https://raw.githubusercontent.com/kebabified/fetchbox/main/firefox/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "nativeMessaging",
    "contextMenus",
    "storage",
    "tabs",
    "notifications"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "key": "",
  "optional_permissions": [
    "cookies"
  ]
}
